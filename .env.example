# Server
PORT=3000
NODE_ENV=development

# Order splitter configuration
# Number of decimal places allowed when computing share quantities.
# Can be changed independently of application code/business logic.
SHARE_QUANTITY_DECIMAL_PLACES=3

# Fixed fallback price (USD) used when a partner does not supply a market
# price for a given symbol in the request.
DEFAULT_STOCK_PRICE=100

# Tolerance (in percentage points) allowed when validating that model
# portfolio weights sum to 100%, to absorb floating point noise from callers.
PORTFOLIO_WEIGHT_TOLERANCE=0.01
